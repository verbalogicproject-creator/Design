{
  "$description": "Synth tab design tokens for Creation Studio. Dark only. Names are proposals; values are what the design uses.",
  "color": {
    "panel": {
      "slate":      { "value": "#33404a", "role": "page background, console panel" },
      "slate-deep": { "value": "#2a353d", "role": "recesses, wells, channel gutters, fields" },
      "slate-lift": { "value": "#3d4b56", "role": "raised faceplates, plates, cards, sheets" },
      "seam":       { "value": "#232c33", "role": "panel seams, dividers, grid lines, unlit segments" },
      "well":       { "value": "#1c2429", "role": "meter wells, LCD glass, input fields", "new": true }
    },
    "metal": {
      "alu":        { "value": "#c5cbcf", "role": "knobs, keys, buttons" },
      "alu-dim":    { "value": "#8e979d", "role": "secondary controls, outlines. Never text.", "contrast": "3.6:1 on slate (UI only)" },
      "alu-shade":  { "value": "#6c757b", "role": "underside of a key", "new": true }
    },
    "tape": {
      "tape":        { "value": "#e6d6a2", "role": "scribble-strip labels only" },
      "tape-shadow": { "value": "#b9a978", "role": "tape edge" },
      "ink":         { "value": "#1f2a33", "role": "marker on tape, ink on aluminium and cap colours", "contrast": "10.1:1 on tape" }
    },
    "signal": {
      "amber":     { "value": "#f2b33d", "role": "signal, level, meters, playhead, focus ring, lit lamps", "contrast": "5.7:1 on slate, 4.8:1 on slate-lift" },
      "amber-off": { "value": "#4d4020", "role": "an unlit lamp", "new": true },
      "tally":     { "value": "#e0452b", "role": "recording, anything that costs money, destructive. Borders and fills only.", "contrast": "3.0:1 on slate-deep (UI only)" }
    },
    "text": {
      "text":       { "value": "#e9ecee", "role": "body text", "contrast": "9.0:1 on slate" },
      "text-dim":   { "value": "#b8c2c9", "role": "secondary text", "was": "#a9b4bc", "changed": true, "contrast": "5.9:1 on slate, 5.0:1 on slate-lift" },
      "tally-text": { "value": "#ffa594", "role": "red as text on dark (prices, errors)", "new": true, "contrast": "5.6:1 on slate, 4.7:1 on slate-lift" },
      "blue-text":  { "value": "#a0c3ef", "role": "blue as text (notes)", "new": true, "contrast": "5.9:1 on slate, 4.9:1 on slate-lift" },
      "green-text": { "value": "#8fd1a9", "role": "green as text (modulation, saved, good)", "new": true, "contrast": "6.0:1 on slate, 5.1:1 on slate-lift" }
    },
    "cap": {
      "cap-red":    { "value": "#d9483b" },
      "cap-yellow": { "value": "#e8c547" },
      "cap-blue":   { "value": "#4a7fc1" },
      "cap-white":  { "value": "#eef0f1" },
      "cap-green":  { "value": "#5ba67a" },
      "$note": "Channel identity on fader caps, pattern blocks, mixer strips. Always shown with a name or number."
    },
    "cable": {
      "audio": { "value": "#f2b33d", "width": 4.5, "dash": "solid", "port": "circle" },
      "notes": { "value": "#4a7fc1", "width": 3.5, "dash": "9 5", "port": "square" },
      "mod":   { "value": "#5ba67a", "width": 3.5, "dash": "1 6 (round caps)", "port": "diamond" }
    }
  },
  "type": {
    "family": { "ui": "Archivo Variable (wght 100-900, wdth 62-125)", "tape": "Permanent Marker (tape labels only)" },
    "features": "font-variant-numeric: tabular-nums everywhere",
    "min-size": "11px",
    "scale": {
      "display":       { "size": 40, "line": 42, "weight": 800, "width": 78 },
      "title":         { "size": 28, "line": 32, "weight": 800, "width": 80 },
      "heading":       { "size": 18, "line": 24, "weight": 700, "width": 85 },
      "section-label": { "size": 15, "line": 20, "weight": 800, "width": 78, "case": "upper", "tracking": "0.14em" },
      "body":          { "size": 14, "line": 20, "weight": 400, "width": 100 },
      "small":         { "size": 12, "line": 16, "weight": 400 },
      "label":         { "size": 11, "line": 12, "weight": 700, "width": 75, "case": "upper", "tracking": "0.08em" },
      "numerals":      { "size": 20, "line": 20, "weight": 700, "tracking": "0.02em", "use": "LCD readouts (amber)" },
      "tape-s":        { "size": 11, "family": "tape", "padding": "3px 6px 2px" },
      "tape":          { "size": 14, "family": "tape", "padding": "5px 9px 4px" },
      "tape-l":        { "size": 18, "family": "tape", "padding": "7px 12px 6px" }
    }
  },
  "space": { "4": 4, "8": 8, "12": 12, "16": 16, "24": 24, "32": 32, "$note": "px. 4 inside controls and between neighbouring targets, 8 between controls, 12 card gaps and plate padding, 16 desktop plate padding, 24 group gaps, 32 section gaps" },
  "radius": { "tape": 2, "cap": 3, "key": 4, "plate": 6, "sheet": "10 10 0 0", "round": "50%" },
  "depth": {
    "$note": "Elevation is physical depth of the part relative to the panel, in px. Light comes from the top.",
    "well":        { "z": -2,  "shadow": "inset 0 2px 4px rgba(0,0,0,.35)" },
    "field":       { "z": -1,  "shadow": "inset 0 2px 3px rgba(0,0,0,.5)" },
    "panel":       { "z": 0,   "shadow": "none" },
    "plate":       { "z": 2,   "shadow": "inset 0 1px 0 rgba(255,255,255,.07), 0 2px 0 rgba(0,0,0,.25)" },
    "key":         { "z": 3,   "shadow": "0 3px 0 #6c757b, 0 5px 6px rgba(0,0,0,.35)" },
    "key-pressed": { "z": 1,   "shadow": "0 1px 0 #6c757b, 0 2px 3px rgba(0,0,0,.35)", "move": "translateY(2px)" },
    "lifted":      { "z": 8,   "shadow": "0 8px 12px rgba(0,0,0,.5)" },
    "sheet":       { "z": 12,  "shadow": "0 -8px 20px rgba(0,0,0,.4)", "edge": "2px solid alu-dim on top" }
  },
  "texture": { "grain": "repeating-linear-gradient(0deg, rgba(255,255,255,.016) 0 1px, rgba(0,0,0,.025) 1px 3px) on every panel" },
  "size": {
    "touch": 44,
    "touch-pointer-min": 26,
    "focus": "2px solid amber, offset 2px",
    "phone": { "portrait": "412 x 880 design frame", "landscape": "892 x 412", "bottom-nav": 60, "rail": 60, "transport-portrait": 106, "transport-wide": 56 },
    "desktop": { "frame": "1440 x 900", "top-nav": 48 },
    "plugin": "900 x 600"
  },
  "motion": {
    "allowed": ["playhead", "recording lamp pulse (1.2s)", "rendering pulse (1.2s)", "key travel 2px, no easing"],
    "reduced-motion": "pulses stop; state remains readable as text and lit lamps"
  },
  "layer": ["panel", "plate", "content", "playhead (5)", "flag hit area (4-7)", "popover (6-11)", "drawer (8)", "scrim (20)", "sheet (21)"]
}
